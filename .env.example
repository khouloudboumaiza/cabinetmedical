# Copier ce fichier en ".env" et remplir les valeurs

# Clé secrète Flask (générer avec: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-moi

# Clé de signature HMAC (différente de SECRET_KEY)
HMAC_SECRET=change-moi-aussi

# Base de données (par défaut: SQLite locale, pas besoin de la définir)
# DATABASE_URL=sqlite:///app.db

# Identifiants OAuth2 Google — voir README.md pour les obtenir
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cookies de session sécurisés (mettre à true derrière HTTPS en production)
SESSION_COOKIE_SECURE=false

# Envoi d'alertes par email (optionnel)
ALERTS_BY_EMAIL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
